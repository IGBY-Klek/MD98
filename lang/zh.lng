; MD98 语言脚本 - 简体中文 (GBK)
; 格式：键=值  (每行一条)
; 以 ';' 或 '#' 开头的行是注释。
; 值中的转义序列：
;   \t 制表符   \n 换行   \r 回车   \0 空字符   \\ 反斜杠

file=文件(&F)
new=新建(&N)\tCtrl+N
open=打开(&O)...\tCtrl+O
save=保存(&S)\tCtrl+S
saveas=另存为(&A)...
exit=退出(&X)

edit=编辑(&E)
undo=撤销(&U)\tCtrl+Z
cut=剪切(&T)\tCtrl+X
copy=复制(&C)\tCtrl+C
paste=粘贴(&P)\tCtrl+V
selectall=全选(&A)\tCtrl+A

view=查看(&V)
wordwrap=自动换行(&W)
refresh=刷新预览(&R)\tF5
language=语言(&L)
langen=English
langzh=简体中文

help=帮助(&H)
about=关于 MD98(&A)...

untitled=未命名
titlefmt=%s - MD98

saveprompt=文档已修改，是否保存更改？
savetitle=MD98

abouttitle=关于 MD98
abouttext=MD98 - Windows 98 下的 Markdown 编辑器\n\n一个用 C 语言和 Win32 API 编写的\n轻量级 Markdown 查看/编辑器。

filter=Markdown 文件 (*.md)\0*.md\0文本文件 (*.txt)\0*.txt\0所有文件 (*.*)\0*.*\0
